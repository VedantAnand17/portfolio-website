{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node scripts/preview.mjs",
    "test": "npm run test:production && node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "npm run build && node scripts/preview.mjs --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "ultracite check && prettier --check \"src/**/*.astro\"",
    "check": "ultracite check && prettier --check \"src/**/*.astro\"",
    "fix": "ultracite fix && prettier --write \"src/**/*.astro\"",
    "typecheck": "astro check && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test:e2e": "playwright test",
    "test:production": "PLAYWRIGHT_SERVER=production playwright test",
    "deploy:built": "wrangler deploy",
    "pretest:production": "node scripts/build-test-site.mjs",
    "pretypecheck": "npm run cf-typegen"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "ultracite": "7.10.2",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    },
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "sharp": "$sharp"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
