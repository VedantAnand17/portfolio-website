{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-website",
  "account_id": "d5addfff98319ee236259e234106087d",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.vedant-dev.com",
      "custom_domain": true,
    },
    {
      "pattern": "vedant-dev.com",
      "custom_domain": true,
    },
    {
      "pattern": "v3dant.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.v3dant.com",
      "custom_domain": true,
    },
  ],
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "issues": { "enabled": true },
  },
  "ratelimits": [
    {
      "name": "ERROR_REPORTS_LIMITER",
      "namespace_id": "2090849178",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
